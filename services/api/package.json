    "mongoose": "8.24.4",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/node": "22.13.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.39.5",
    "globals": "16.0.0",
    "supertest": "7.1.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vitest": "3.2.7"
  }
