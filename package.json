{
  "name": "tox-intl-platform-stabilization",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "services/api"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace services/api run dev",
